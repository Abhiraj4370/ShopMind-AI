# ==================================================
# ShopMind AI - Environment Variables
# ==================================================
# Copy this file to .env and fill in your API keys

# --- LLM Providers ---
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=shopmind-ai

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=development

MISTRAL_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_MODEL=mistral-large-latest
OPENROUTER_MODEL=openrouter/free
AI_PROVIDER_ORDER=gemini,groq,mistral,openrouter
TAVILY_API_KEY=

# --- Security ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_QUERY_LENGTH=1000
RATE_LIMIT_PER_MINUTE=30

ALLOW_EXTERNAL_MERCHANT_DISCOVERY=false

# v9 product intelligence
SHOPMIND_DB_PATH=data/shopmind.db
ADMIN_API_KEY=
